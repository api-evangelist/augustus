{
  "opencollection": "1.0.0",
  "info": {
    "name": "Augustus Banking Account Programs Accounts API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/accounts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page (1-100). Defaults to 10."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor from a previous next_cursor."
              },
              {
                "name": "account_number",
                "value": "",
                "type": "query",
                "description": "Filter by exact fiat account number. Crypto wallets are excluded when set."
              },
              {
                "name": "account_holder_name",
                "value": "",
                "type": "query",
                "description": "Filter by account holder name (case-insensitive phrase match). Crypto wallets are excluded when set."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by account status."
              },
              {
                "name": "parent_id",
                "value": "",
                "type": "query",
                "description": "ID of the account program to list virtual accounts for."
              }
            ]
          },
          "docs": "Returns a paginated list of accounts."
        },
        {
          "info": {
            "name": "Create account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.augustus.com/v1/accounts",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new account."
        },
        {
          "info": {
            "name": "Retrieve account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account."
              }
            ]
          },
          "docs": "Retrieves an account by ID."
        },
        {
          "info": {
            "name": "Retrieve account balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/accounts/:id/balance",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account."
              }
            ]
          },
          "docs": "Retrieves the available balance for an account."
        },
        {
          "info": {
            "name": "Freeze account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.augustus.com/v1/accounts/:id/freeze",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account."
              }
            ]
          },
          "docs": "Freezes an account"
        },
        {
          "info": {
            "name": "Close account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.augustus.com/v1/accounts/:id/close",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Closes an account"
        },
        {
          "info": {
            "name": "Unfreeze account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.augustus.com/v1/accounts/:id/unfreeze",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account."
              }
            ]
          },
          "docs": "Unfreezes an account"
        }
      ]
    }
  ],
  "bundled": true
}