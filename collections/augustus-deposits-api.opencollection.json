{
  "opencollection": "1.0.0",
  "info": {
    "name": "Augustus Banking Account Programs Deposits API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve deposit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/deposits/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the deposit."
              }
            ]
          },
          "docs": "Retrieves a deposit by ID."
        },
        {
          "info": {
            "name": "List deposits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/deposits",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page (1-100). Defaults to 10."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor from a previous next_cursor."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by deposit status."
              },
              {
                "name": "created_at.gte",
                "value": "",
                "type": "query",
                "description": "Include deposits whose created_at is greater than or equal to this ISO 8601 timestamp."
              },
              {
                "name": "created_at.lte",
                "value": "",
                "type": "query",
                "description": "Include deposits whose created_at is less than or equal to this ISO 8601 timestamp."
              }
            ]
          },
          "docs": "Lists deposits for the merchant with cursor-based pagination."
        }
      ]
    }
  ],
  "bundled": true
}