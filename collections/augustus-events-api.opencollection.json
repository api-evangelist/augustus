{
  "opencollection": "1.0.0",
  "info": {
    "name": "Augustus Banking Account Programs Events API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/events/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the event."
              }
            ]
          },
          "docs": "Retrieves a webhook event by ID."
        },
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.augustus.com/v1/events",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page (1-100). Defaults to 10."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor from a previous next_cursor."
              },
              {
                "name": "event_type",
                "value": "",
                "type": "query",
                "description": "Filter by event type."
              },
              {
                "name": "created_at.gte",
                "value": "",
                "type": "query",
                "description": "Include events whose created_at is greater than or equal to this ISO 8601 timestamp."
              },
              {
                "name": "created_at.lte",
                "value": "",
                "type": "query",
                "description": "Include events whose created_at is less than or equal to this ISO 8601 timestamp."
              }
            ]
          },
          "docs": "Lists webhook events for the merchant with cursor-based pagination. Events are retained for 30 days."
        }
      ]
    }
  ],
  "bundled": true
}